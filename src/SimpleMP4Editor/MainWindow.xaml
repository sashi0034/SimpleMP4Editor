<Window x:Class="SimpleMP4Editor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SimpleMP4Editor"
 Title="Simple MP4 Editor" Width="1140" Height="760" MinWidth="840" MinHeight="620"
 Background="#EDF2F3" FontFamily="Segoe UI, Yu Gothic UI" FontSize="13" UseLayoutRounding="True"
 AllowDrop="True" Drop="FilesDropped" DragOver="FilesOver" PreviewKeyDown="WindowKey">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#172C33" Padding="20,12">
   <DockPanel>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
     <Button x:Name="AddButton" Content="＋ 動画を追加" Click="OpenFiles" ToolTip="Ctrl+O" Margin="0,0,8,0"/>
     <Button x:Name="ExportButton" Content="書き出す…" Click="Save" Background="#84E2CF" BorderBrush="#84E2CF" FontWeight="SemiBold" Padding="20,6" IsEnabled="False"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="32" Height="32" Background="#85E4CF" CornerRadius="7">
      <Path Stroke="#123D38" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"
       Data="M 2,0 L 2,14 L 16,14 M 0,2 L 14,2 L 14,16"/>
     </Border>
     <TextBlock Text="Simple MP4 Editor" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="Workspace" Grid.Row="1" Margin="16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="254"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="8" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10">
      <CheckBox x:Name="ResultMode" Content="仕上がりを表示" DockPanel.Dock="Right" VerticalAlignment="Center" IsEnabled="False" Click="ViewChanged"/>
      <TextBlock x:Name="PreviewTitle" Text="プレビュー" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
     </DockPanel>
     <Border Grid.Row="1" Background="#101D23" CornerRadius="5" Padding="10">
      <Grid x:Name="Stage" SizeChanged="StageResized" ClipToBounds="True">
       <Canvas IsHitTestVisible="False">
        <Canvas x:Name="Viewport" ClipToBounds="True" Background="Black">
         <Grid x:Name="SourceVisual">
          <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True"
           Stretch="Fill" MediaOpened="PlayerOpened" MediaEnded="PlayerEnded" MediaFailed="PlayerFailed"/>
          <Image x:Name="Still" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
         </Grid>
        </Canvas>
       </Canvas>
       <local:CropOverlay x:Name="Overlay"/>
       <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Path Data="M 2,3 L 26,3 26,21 2,21 Z M 11,8 L 18,12 11,16 Z" Stroke="#85E4CF" StrokeThickness="1.5" Stretch="Uniform" Width="46" Height="36" HorizontalAlignment="Center"/>
        <TextBlock Text="MP4 をここにドロップ" Foreground="White" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
        <Button Content="ファイルを選ぶ" Click="OpenFiles" HorizontalAlignment="Center" Padding="14,4"/>
       </StackPanel>
      </Grid>
     </Border>
     <StackPanel Grid.Row="2" x:Name="Transport" Margin="0,12,0,0" IsEnabled="False">
      <DockPanel>
       <TextBlock x:Name="TimeLabel" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" DockPanel.Dock="Right" Text="00:00.000 / 00:00.000"/>
       <Button x:Name="PlayButton" Content="▶  再生" Click="TogglePlay" ToolTip="Space" HorizontalAlignment="Left"/>
      </DockPanel>
      <local:RangeTrack x:Name="Track" Height="38" Margin="0,8,0,3" ToolTip="バーをクリックして移動。両端のハンドルで開始・終了を設定"/>
      <WrapPanel VerticalAlignment="Center">
       <Button Content="開始に設定  I" Click="MarkStart" Margin="0,0,6,0"/>
       <Button Content="終了に設定  O" Click="MarkEnd" Margin="0,0,10,0"/>
       <TextBlock x:Name="RangeLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      </WrapPanel>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" CornerRadius="8" Background="White" Padding="14">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,8">
      <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
      <TextBlock Text="クリップ" Style="{StaticResource Title}"/>
     </DockPanel>
     <ListBox Grid.Row="1" x:Name="ClipList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        HorizontalContentAlignment="Stretch" SelectionChanged="ClipSelected" AutomationProperties.Name="結合順のクリップ">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Margin="4,5" ToolTip="{Binding Media.Path}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="2" Margin="0,8,0,0">
      <UniformGrid Rows="1" Columns="4">
       <Button x:Name="UpButton" Click="MoveUp" Content="↑" ToolTip="順番を上げる" Padding="2"/>
       <Button x:Name="DownButton" Click="MoveDown" Content="↓" ToolTip="順番を下げる" Padding="2"/>
       <Button x:Name="CopyButton" Click="Duplicate" Content="複製" ToolTip="同じ素材から別の区間を追加" Padding="2"/>
       <Button x:Name="RemoveButton" Click="Remove" Content="削除" ToolTip="リストから削除" Padding="2"/>
      </UniformGrid>
      <Separator Margin="0,14,0,12"/>
      <StackPanel x:Name="CropOptions" IsEnabled="False">
       <TextBlock Text="切り抜き枠" Style="{StaticResource Title}"/>
       <TextBlock x:Name="CropLabel" FontFamily="Consolas" FontSize="15" Margin="0,5,0,7"/>
       <CheckBox x:Name="Mirror" Content="対称に調整" Click="MirrorChanged" ToolTip="向かい合う辺を中心から同じ距離だけ動かす"/>
       <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,8" Text="辺をつまんで調整。矢印キーで 1 px、Shift と矢印キーで 10 px 移動。"/>
       <Button Content="全画面に戻す" HorizontalAlignment="Left" Click="ResetCrop"/>
      </StackPanel>
      <Separator Margin="0,14,0,12"/>
      <TextBlock Text="結合時の画面合わせ" Style="{StaticResource Title}" Margin="0,0,0,7"/>
      <ComboBox x:Name="FitMode" SelectedIndex="0" SelectionChanged="FitChanged" Padding="6,4" AutomationProperties.Name="結合時の画面合わせ">
       <ComboBoxItem Content="画面を埋める"/><ComboBoxItem Content="全体を収める（黒帯）"/>
      </ComboBox>
      <TextBlock x:Name="OutputLabel" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#DFE8E9" Padding="16,6">
   <DockPanel>
    <StackPanel x:Name="ExportProgress" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
     <ProgressBar x:Name="Progress" Width="135" Height="8" Minimum="0" Maximum="1" VerticalAlignment="Center"/>
     <Button Content="キャンセル" Click="CancelExport" Margin="8,0,0,0" MinHeight="23" Padding="8,1"/>
    </StackPanel>
    <TextBlock x:Name="Status" Text="動画を追加して編集を開始" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
